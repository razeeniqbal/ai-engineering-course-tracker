# Copy to .env for local runs (never commit .env). In production, set these in the host's dashboard.
APP_ENV=dev
DATABASE_URL=sqlite:///./dev.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true in production (HTTPS); false only for http://localhost
COOKIE_SECURE=false
DISPLAY_TZ=Asia/Kuala_Lumpur
# Sign in through the portfolio admin (portfolio.madebyrazeen.com/admin). Same value as the portfolio's
# MBR_SSO_SECRET; works once the tracker is served on a madebyrazeen.com subdomain. Empty = off.
MBR_SSO_SECRET=

# Backups (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_PASSPHRASE=
BACKUP_S3_URI=
AWS_ENDPOINT_URL=
