# Copy to .env for local runs (never commit .env). In production, set these in the host's dashboard.
APP_ENV=dev
DATABASE_URL=sqlite:///./dev.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# true in production (HTTPS); false only for http://localhost
COOKIE_SECURE=false
DISPLAY_TZ=Asia/Kuala_Lumpur

# Backups (scripts/backup.sh)
BACKUP_DIR=./backups
BACKUP_PASSPHRASE=
BACKUP_S3_URI=
AWS_ENDPOINT_URL=
